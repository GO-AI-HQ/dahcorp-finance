# ─────────────────────────────────────────────────────────────────────────────
# DAHCORP FINANCE — environment template
#
# Copy to `.env` for local development, or set these as environment variables in
# the Netlify UI for a deploy. No real secret may ever be committed.
# ─────────────────────────────────────────────────────────────────────────────

# ── ACCESS CONTROL ────────────────────────────────────────────────────────────
DAHCORP_ACCESS_PASSCODE=
# DAHCORP_SESSION_SECRET=
DAHCORP_SESSION_TTL_MINUTES=60
DAHCORP_ALLOW_PUBLIC_DEMO=false

# ── CLAUDE (optional) ─────────────────────────────────────────────────────────
CLAUDE_MODEL=claude-sonnet-5
# ANTHROPIC_API_KEY=

# ── MARKET DATA ───────────────────────────────────────────────────────────────
# Broad analytical history still uses the deterministic provider. Each live
# execution lane independently refreshes its broker quote before preview/place.
MARKET_DATA_PROVIDER=mock

# ── MARKET INTELLIGENCE ───────────────────────────────────────────────────────
# Direct news / congressional enrichment.
# FINNHUB_API_KEY=
# AINVEST_API_KEY=

# Primary Market Pulse: BDI, SOX, WTI, Brent and NDX. The adapter resolves
# TradingEconomics symbols at runtime and validates the known suffix convention.
# TRADINGECONOMICS_API_KEY=

# OpenBB stays in its own isolated Cloud Run service. This URL is not a secret.
# OPENBB_REST_URL=https://your-private-openbb-service.run.app
# OPENBB_AUDIENCE=https://your-private-openbb-service.run.app
OPENBB_MARKET_PROVIDER=yfinance

# Because the OpenBB Cloud Run service should remain private, Netlify needs a
# dedicated Google service account with ONLY Cloud Run Invoker on that service.
# Store the complete JSON credential as one Netlify secret value. Never commit it.
# OPENBB_GOOGLE_SERVICE_ACCOUNT_JSON={}

# ── DATABASE ──────────────────────────────────────────────────────────────────
# Netlify Database stores encrypted broker OAuth records and single-use previews.
# NETLIFY_DATABASE_URL=

# ── CHARLES SCHWAB ───────────────────────────────────────────────────────────
SCHWAB_MODE=live
# SCHWAB_CLIENT_ID=
# SCHWAB_CLIENT_SECRET=
SCHWAB_CALLBACK_URL=https://your-site.example/.netlify/functions/schwab-callback
SCHWAB_API_BASE_URL=https://api.schwabapi.com
# SCHWAB_TOKEN_ENCRYPTION_KEY=
SCHWAB_EXECUTION_ENABLED=false
# SCHWAB_REFRESH_TOKEN=

# Retail funding/money movement is not exposed by the Individual Trader API.
# Fund through Schwab/MoneyLink; DAHCorp reads broker-reported cash after arrival.

# ── ROBINHOOD AGENTIC TRADING MCP ────────────────────────────────────────────
# Official MCP only. No unofficial Robinhood private API and no username/password.
ROBINHOOD_MODE=live
ROBINHOOD_MCP_ENDPOINT=https://agent.robinhood.com/mcp/trading
# DAHCorp web callback, retained for providers/clients that permit remote HTTPS.
ROBINHOOD_CALLBACK_URL=https://your-site.example/.netlify/functions/robinhood-callback

# Robinhood currently rejects some arbitrary remote HTTPS redirect URIs for
# dynamically registered MCP clients. A desktop loopback redirect keeps the
# OAuth client within Robinhood's accepted MCP pattern while DAHCorp performs
# the PKCE token exchange after the user pastes the one-time localhost callback
# URL back into the private dashboard. Example only:
# ROBINHOOD_OAUTH_REDIRECT_URI=http://localhost:1455/callback

# Optional dedicated encryption key for Robinhood OAuth tokens. If omitted, the
# existing SCHWAB_TOKEN_ENCRYPTION_KEY is used as the broker-vault key. Either
# key must be at least 32 characters and must remain server-side.
# ROBINHOOD_TOKEN_ENCRYPTION_KEY=

# Keep false until explicit live-order verification is complete. Human-confirmed
# execution remains the ceiling; no LLM may bypass the deterministic policy layer.
ROBINHOOD_EXECUTION_ENABLED=false
