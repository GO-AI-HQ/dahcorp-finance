# ─────────────────────────────────────────────────────────────────────────────
# DAHCORP FINANCE — environment template
#
# Copy to `.env` for local development, or set these as environment variables in
# the Netlify UI (Site configuration → Environment variables) for a deploy.
#
# NOTHING IN THIS FILE IS A REAL SECRET, AND NO REAL SECRET MAY EVER BE
# COMMITTED. `.env` is gitignored. Every variable here is read only inside
# Netlify Functions (server side). None is prefixed `VITE_`, so none is bundled
# into the browser. Adding a secret to a `VITE_`-prefixed variable would publish
# it to anyone who opens the site — do not do it.
# ─────────────────────────────────────────────────────────────────────────────


# ── ACCESS CONTROL (required) ────────────────────────────────────────────────
# This is a private dashboard for one investor. It is not a public site.
#
# The passcode gates the entire application. With no passcode configured the API
# is LOCKED rather than open: every data function returns 401 and the UI shows a
# setup notice. Use a long, random value.
DAHCORP_ACCESS_PASSCODE=

# HMAC key used to sign the session cookie. Strongly recommended — set it to at
# least 32 random characters, e.g. `openssl rand -base64 48`.
# If unset, a key is derived from the passcode instead, which works but
# invalidates all sessions whenever the passcode is rotated.
DAHCORP_SESSION_SECRET=

# Idle session lifetime in minutes. Default 60, maximum 1440. The UI counts down
# and returns to the sign-in screen when it lapses.
DAHCORP_SESSION_TTL_MINUTES=60

# Escape hatch for demoing the mock dataset with no passcode. Leave EMPTY or
# `false` for any real use. When `true`, the server still refuses to start a
# public session if any live credential below is present.
DAHCORP_ALLOW_PUBLIC_DEMO=false


# ── CLAUDE (optional) ────────────────────────────────────────────────────────
# Recommended path: enable the Netlify AI Gateway on the site. The platform then
# injects model credentials into the function runtime and you set NO key here.
#
# With no credentials present, /analyze still works: it returns the
# deterministic brief and reports "no model available". It never fails silently.
#
# Allow-listed: claude-opus-5 | claude-sonnet-5 | claude-haiku-4-5 |
# claude-opus-4-8. Anything else falls back to claude-sonnet-5.
CLAUDE_MODEL=claude-sonnet-5

# Only if you are NOT using the AI Gateway. Server-side only; never expose it.
# ANTHROPIC_API_KEY=


# ── MARKET DATA (optional) ───────────────────────────────────────────────────
# `mock` is the only provider implemented in this build. Any other value logs a
# warning and falls back to mock, so the dashboard is never quietly wrong about
# where its prices came from — every payload carries a dataQuality flag.
MARKET_DATA_PROVIDER=mock


# ── DATABASE (optional) ──────────────────────────────────────────────────────
# Provisioned automatically by Netlify Database (`netlify db init`), which sets
# NETLIFY_DATABASE_URL for you. Without it the app runs read-only on seed data:
# strategy settings, the audit log and recommendation history are not persisted.
# NETLIFY_DATABASE_URL=


# ── CHARLES SCHWAB (leave unset in Phase 1) ──────────────────────────────────
# mock | live. `mock` requires no credentials. `live` is not implemented in this
# build; the adapter reports what is missing rather than guessing. See
# docs/BROKER_ARCHITECTURE.md.
SCHWAB_MODE=mock
# SCHWAB_CLIENT_ID=
# SCHWAB_CLIENT_SECRET=
# SCHWAB_REDIRECT_URI=https://your-site.netlify.app/oauth/schwab/callback
# SCHWAB_API_BASE_URL=https://api.schwabapi.com
#
# OAuth refresh token. When live integration is added this belongs in encrypted
# server-side storage, not in a plaintext environment variable, and never in the
# browser or localStorage.
# SCHWAB_REFRESH_TOKEN=


# ── ROBINHOOD (leave unset in Phase 1) ───────────────────────────────────────
# mock | manual | live. Designed against the official agentic/MCP ecosystem;
# no unofficial private API is used and no username/password is ever accepted.
ROBINHOOD_MODE=mock
# ROBINHOOD_MCP_ENDPOINT=
# ROBINHOOD_ACCESS_TOKEN=
